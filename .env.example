# =============================================================================
# Variables de entorno requeridas
#
# Local:  copia este archivo a `.env.local` y rellena los valores reales.
# Vercel: configúralas en Project Settings -> Environment Variables.
#
# NUNCA subas `.env.local` (está en .gitignore). Este archivo es solo la
# plantilla, sin secretos.
# =============================================================================

# --- Anthropic (servidor) -----------------------------------------------------
# Clave de la API de Claude. Solo servidor; nunca se expone al cliente.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase (cliente + servidor) -------------------------------------------
# URL del proyecto e API key pública (anon). Ambas son NEXT_PUBLIC_ (visibles en
# el navegador); la seguridad real la da Row Level Security en la base de datos.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Clave de rol de servicio (service_role). SOLO SERVIDOR: se salta Row Level
# Security, así que NUNCA debe llevar el prefijo NEXT_PUBLIC_ ni exponerse al
# navegador. La usan el webhook de Mercado Pago y la creación de la suscripción,
# que escriben el estado de pago sin sesión de usuario.
# Supabase Dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Mercado Pago (suscripciones, Chile / CLP) --------------------------------
# Credenciales de la aplicación: Mercado Pago -> Tus integraciones -> tu app ->
# "Credenciales de producción" (o "de prueba" para el entorno sandbox).
#
# Access token. SOLO SERVIDOR: permite cobrar en tu nombre.
# Pruebas: empieza por TEST-...  |  Producción: empieza por APP_USR-...
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public key. Es pública por diseño (identifica la cuenta en el navegador).
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clave secreta para validar la firma de los webhooks (cabecera `x-signature`).
# Mercado Pago -> Tus integraciones -> tu app -> Webhooks -> "Clave secreta".
# Si se deja vacía, el webhook igual funciona (los datos siempre se re-consultan
# a la API de Mercado Pago), pero se pierde una capa de defensa: configúrala.
MERCADOPAGO_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Datos de mercado (Análisis de Mercado) -----------------------------------
# Clave de Finnhub (https://finnhub.io) para el precio, la variación, la
# capitalización, el P/E y la rentabilidad por dividendo de la sección
# "Análisis de Mercado". SOLO SERVIDOR: el navegador nunca habla con el
# proveedor, siempre pasa por /api/market/quote.
#
# OPCIONAL: sin ella la sección sigue funcionando (catálogo, gráficos simulados
# y análisis con IA), pero cada métrica aparece como "—" con el aviso de que los
# datos en vivo no están configurados. NUNCA se rellenan con estimaciones.
#
# Nota: en el plan gratuito de Finnhub el historial de precios (/stock/candle)
# suele estar restringido; en ese caso la ficha lo dice y cae en el gráfico
# simulado, que no depende del proveedor.
FINNHUB_API_KEY=xxxxxxxxxxxxxxxxxxxx

# --- URL pública del sitio ----------------------------------------------------
# Se usa para construir la `back_url` a la que Mercado Pago devuelve al usuario
# tras autorizar la suscripción. En local: http://localhost:3000
# En Vercel, si se omite, se deriva de VERCEL_URL automáticamente.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
